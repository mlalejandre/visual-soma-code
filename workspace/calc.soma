// SOMA-LANG: Calculadora Interactiva Ring 0
let win_w = 340;
let win_h = 420;
let display = "0";
let val_a = 0;
let op = "";
let nuevo = 1;

fn dibujar(d) {
    win.clear(0x0F172A);
    win.rect(20, 20, 300, 60, 0x1E293B);
    win.rect(22, 22, 296, 56, 0x0B132B);
    win.text(40, 42, d, 0x38BDF8);

    win.rect(20, 100, 65, 55, 0x1E293B); win.text(48, 120, "7", 0xFFFFFF);
    win.rect(95, 100, 65, 55, 0x1E293B); win.text(123, 120, "8", 0xFFFFFF);
    win.rect(170, 100, 65, 55, 0x1E293B); win.text(198, 120, "9", 0xFFFFFF);
    win.rect(245, 100, 65, 55, 0x334155); win.text(273, 120, "/", 0x00FF88);

    win.rect(20, 165, 65, 55, 0x1E293B); win.text(48, 185, "4", 0xFFFFFF);
    win.rect(95, 165, 65, 55, 0x1E293B); win.text(123, 185, "5", 0xFFFFFF);
    win.rect(170, 165, 65, 55, 0x1E293B); win.text(198, 185, "6", 0xFFFFFF);
    win.rect(245, 165, 65, 55, 0x334155); win.text(273, 185, "*", 0x00FF88);

    win.rect(20, 230, 65, 55, 0x1E293B); win.text(48, 250, "1", 0xFFFFFF);
    win.rect(95, 230, 65, 55, 0x1E293B); win.text(123, 250, "2", 0xFFFFFF);
    win.rect(170, 230, 65, 55, 0x1E293B); win.text(198, 250, "3", 0xFFFFFF);
    win.rect(245, 230, 65, 55, 0x334155); win.text(273, 250, "-", 0x00FF88);

    win.rect(20, 295, 65, 55, 0x3B151E); win.text(48, 315, "C", 0xF43F5E);
    win.rect(95, 295, 65, 55, 0x1E293B); win.text(123, 315, "0", 0xFFFFFF);
    win.rect(170, 295, 65, 55, 0x064E3B); win.text(198, 315, "=", 0x34D399);
    win.rect(245, 295, 65, 55, 0x334155); win.text(273, 315, "+", 0x00FF88);

    win.text(35, 380, "SOMA CALC [Ring 0 OK]", 0x64748B);
    win.present();
}

if (fb.is_active()) {
    win.create("Calculadora SOMA", 200, 100, win_w, win_h);
    dibujar(display);

    while (win.active()) {
        let m = win.mouse();
        if (m.clicked) {
            let mx = m.x;
            let my = m.y;
            let tecla = "";

            if (my >= 100 && my <= 155) {
                if (mx >= 20 && mx <= 85) { tecla = "7"; }
                if (mx >= 95 && mx <= 160) { tecla = "8"; }
                if (mx >= 170 && mx <= 235) { tecla = "9"; }
                if (mx >= 245 && mx <= 310) { tecla = "/"; }
            }
            if (my >= 165 && my <= 220) {
                if (mx >= 20 && mx <= 85) { tecla = "4"; }
                if (mx >= 95 && mx <= 160) { tecla = "5"; }
                if (mx >= 170 && mx <= 235) { tecla = "6"; }
                if (mx >= 245 && mx <= 310) { tecla = "*"; }
            }
            if (my >= 230 && my <= 285) {
                if (mx >= 20 && mx <= 85) { tecla = "1"; }
                if (mx >= 95 && mx <= 160) { tecla = "2"; }
                if (mx >= 170 && mx <= 235) { tecla = "3"; }
                if (mx >= 245 && mx <= 310) { tecla = "-"; }
            }
            if (my >= 295 && my <= 350) {
                if (mx >= 20 && mx <= 85) { tecla = "C"; }
                if (mx >= 95 && mx <= 160) { tecla = "0"; }
                if (mx >= 170 && mx <= 235) { tecla = "="; }
                if (mx >= 245 && mx <= 310) { tecla = "+"; }
            }

            if (tecla == "C") {
                display = "0";
                val_a = 0;
                op = "";
                nuevo = 1;
                dibujar(display);
            } else if (tecla == "+" || tecla == "-" || tecla == "*" || tecla == "/") {
                val_a = to_int(display);
                op = tecla;
                nuevo = 1;
            } else if (tecla == "=") {
                let val_b = to_int(display);
                let res = 0;
                if (op == "+") { res = val_a + val_b; }
                if (op == "-") { res = val_a - val_b; }
                if (op == "*") { res = val_a * val_b; }
                if (op == "/") {
                    if (val_b != 0) { res = val_a / val_b; } else { res = 0; }
                }
                display = to_str(res);
                nuevo = 1;
                dibujar(display);
            } else if (tecla != "") {
                if (nuevo == 1 || display == "0") {
                    display = tecla;
                    nuevo = 0;
                } else {
                    display = display + tecla;
                }
                dibujar(display);
            }
            sys.sleep(150);
        }
        sys.sleep(30);
    }
}
